FROM node:20-slim

WORKDIR /app

# Install convex CLI
RUN npm install -g convex

# Copy only convex files needed for deployment
COPY convex/ ./convex/
COPY package.json ./

# Install dependencies (for convex functions)
RUN npm install

# Default command - deploy to self-hosted Convex
# Override CONVEX_URL with your VPS URL
CMD ["npx", "convex", "deploy", "--cmd", "echo 'Deployment complete'"]
