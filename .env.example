# ===========================================
# Convex Backend Configuration
# ===========================================

# Port for Convex backend API
CONVEX_PORT=3210

# Port for Convex site proxy (HTTP actions)
SITE_PROXY_PORT=3211

# Port for Convex dashboard
DASHBOARD_PORT=6791

# Port for frontend app
APP_PORT=3000

# Public URLs (set these to your VPS domain in production)
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210

# Logging level (error, warn, info, debug, trace)
RUST_LOG=info

# Document retention delay in seconds (default: 2 days)
DOCUMENT_RETENTION_DELAY=172800

# ===========================================
# Deployment Configuration
# ===========================================

# URL of self-hosted Convex backend for deployment
CONVEX_SELF_HOST_URL=http://backend:3210

# Admin key is auto-generated from backend container
# No need to set manually

# ===========================================
# Optional: S3 Storage (for production)
# ===========================================

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_STORAGE_FILES_BUCKET=
# S3_STORAGE_EXPORTS_BUCKET=
# S3_STORAGE_MODULES_BUCKET=
# S3_STORAGE_SEARCH_BUCKET=
# S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=
# S3_ENDPOINT_URL=

# ===========================================
# Optional: Database (for production)
# ===========================================

# POSTGRES_URL=
# MYSQL_URL=
# DATABASE_URL=
